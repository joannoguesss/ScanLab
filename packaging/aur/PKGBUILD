# Maintainer: Joan <sprite_eagles.3y@icloud.com>
pkgname=scanlab
pkgver=0.1.0
pkgrel=1
pkgdesc="Aplicació d'escaneig per a l'Epson Perfection V500 Photo (GUI PySide6 sobre SANE)"
arch=('any')
url="https://github.com/joannoguesss/ScanLab"
license=('MIT')
depends=('python' 'pyside6' 'python-pillow' 'python-sane' 'sane')
optdepends=(
  'iscan: driver epkowa d'\''Epson necessari per al V500 (AUR)'
  'iscan-plugin-gt-x770: plugin del V500 per a iscan (AUR)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # actualitzar amb updpkgsums en publicar

package() {
  cd "ScanLab-$pkgver"

  # Codi de l'aplicació a /usr/share/scanlab
  install -dm755 "$pkgdir/usr/share/scanlab"
  cp -r scanlab "$pkgdir/usr/share/scanlab/"
  install -Dm644 launcher.py "$pkgdir/usr/share/scanlab/launcher.py"

  # Llançador, .desktop i llicència
  install -Dm755 packaging/linux/scanlab "$pkgdir/usr/bin/scanlab"
  install -Dm644 packaging/linux/scanlab.desktop \
    "$pkgdir/usr/share/applications/scanlab.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
